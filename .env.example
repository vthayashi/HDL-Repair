# Copy to .env and fill in. Every variable is optional except HF_TOKEN for LLM repair.

# --- LLM (Hugging Face Inference Router) ---
HF_TOKEN=
# HF_BASE_URL=https://router.huggingface.co/v1
# HF_PROVIDER=auto
# HF_MODEL_REPAIRER=deepseek-ai/DeepSeek-V3
# HF_MODEL_ANALYST=deepseek-ai/DeepSeek-R1
# HF_MODEL_REPAIRER_FALLBACKS=
# HF_MODEL_ANALYST_FALLBACKS=
# HF_MAX_TOKENS_REPAIRER=6000
# HF_MAX_TOKENS_ANALYST=1200
# HF_HTTP_RETRIES=2
# HF_HTTP_TIMEOUT_SEC=45

# --- Loop control ---
# MAX_ITERATIONS=8
# MAX_TOTAL_TOKENS_EST=120000
# MAX_CANDIDATE_GEN_RETRIES=3
# MIN_RTL_CHARS=500

# --- Tool flow ---
# RUN_SIM_BACKEND=auto
# RUN_SYNTHESIS=1
# RUN_PPA=1
# SIM_TIMEOUT_SEC=90
# SYNTH_TIMEOUT_SEC=1800

# --- Synthesis / PPA ---
# SKY130_LIB=lib/sky130_fd_sc_hd__tt_025C_1v80.lib
# BASELINE_AREA_REPORT=
# BASELINE_STA_REPORT=
