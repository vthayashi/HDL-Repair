# =========================================================
# HDL-Repair — environment template. Copy to .env and fill in.
# =========================================================

# Hugging Face Inference Router credentials (reused from the AHA notebook)
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_PROVIDER=auto

# Models (repairer = attacker-refiner re-framed; analyst = judge re-framed)
HF_MODEL_REPAIRER=deepseek-ai/DeepSeek-V3
HF_MODEL_ANALYST=deepseek-ai/DeepSeek-R1
HF_MODEL_REPAIRER_FALLBACKS=Qwen/Qwen2.5-72B-Instruct
HF_MODEL_ANALYST_FALLBACKS=

# Token budgets per call
HF_MAX_TOKENS_REPAIRER=6000
HF_MAX_TOKENS_ANALYST=1200

# Network resiliency
HF_HTTP_RETRIES=4
HF_HTTP_BACKOFF_BASE_SEC=1.0
HF_HTTP_BACKOFF_CAP_SEC=12.0
HF_HTTP_TIMEOUT_SEC=120

# Candidate quality / loop control
MAX_CANDIDATE_GEN_RETRIES=3
MIN_RTL_CHARS=500
MAX_ITERATIONS=8
MAX_TOTAL_TOKENS_EST=120000

# Tool flow
RUN_SIM_BACKEND=auto
RUN_SYNTHESIS=1
RUN_PPA=1
SIM_TIMEOUT_SEC=600
SYNTH_TIMEOUT_SEC=1800

# sky130 Liberty for Yosys. Defaults to the AHA challenge copy if present;
# override here if you move it (13 MB file, not duplicated in this repo).
# SKY130_LIB=../AHA_Challenge_2026/aes/aes_synth/sky130_fd_sc_hd__tt_025C_1v80.lib
